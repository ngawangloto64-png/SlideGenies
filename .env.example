# Which AI to use: ollama (free, local) | google (free tier) | gateway (paid)
AI_PROVIDER=ollama

# 1) FREE, local — install Ollama, then: ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_URL=http://localhost:11434

# 2) FREE tier, no card — key from https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash

# 3) Paid — Vercel AI Gateway (needs a card on file)
# AI_GATEWAY_API_KEY=
# AI_MODEL=anthropic/claude-sonnet-5.5
